{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BECKIE",
  "version": "2.0.0",
  "identifier": "com.beckie.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BECKIE HUD - Tactical Telemetry",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
